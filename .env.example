# Copy to .env for local development. On Railway, set these as service variables.
# Never commit a real token — anyone holding it controls the bot.

# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Right-click your server -> Copy Server ID (needs Developer Mode on)
DISCORD_GUILD_ID=

# The #event-builder text channel, where the "New event" button lives
EVENT_BUILDER_CHANNEL_ID=

# The #events forum channel, where event posts are created
EVENTS_FORUM_CHANNEL_ID=

# Where SQLite lives. On Railway this must sit inside the mounted volume.
# Locally, use something like ./data/events.db
DATABASE_PATH=/data/events.db

# Decides what "Friday 7pm" means when a host types it. Use an IANA zone name.
TZ=America/Chicago

# How long before an event the reminder is posted in its thread.
# 1440 = the day before, 60 = an hour before. Max 10080 (7 days).
REMINDER_LEAD_MINUTES=1440

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# Build output — Railway runs `npm run build`, so dist/ is never committed
dist/
*.tsbuildinfo

# Secrets. DISCORD_TOKEN lives here locally and in Railway variables in prod;
# it must never reach the repo. .env.example IS tracked, as the template.
.env
.env.*
!.env.example

# SQLite database and its WAL sidecars. This is real member data (who RSVPed to
# what) as well as machine-local state — the production copy lives on the
# Railway volume, not in git.
data/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Logs and crash dumps
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Test and tooling caches
coverage/
.nyc_output/
.eslintcache
.cache/
.npm/

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Claude Code local overrides (shared project settings stay tracked)
.claude/settings.local.json

# OS cruft
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
